                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"institution\": \"Universitas Indonesia\",\n    \"bio\": \"Mahasiswa TI\"\n}",
                                    "options": { "raw": { "language": "json" } }
                                },
                                "url": "{{baseUrl}}/auth/profile"
