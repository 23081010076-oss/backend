                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"name\": \"Student Budi\",\n    \"email\": \"student.budi@example.com\",\n    \"password\": \"password\",\n    \"password_confirmation\": \"password\",\n    \"role\": \"student\"\n}",
                                    "options": { "raw": { "language": "json" } }
                                },
                                "url": "{{baseUrl}}/register"
                            }
                        },
                        {
                            "name": "Login Student",
                            "event": [
                                {
                                    "listen": "test",
                                    "script": {
                                        "exec": [
                                            "var jsonData = pm.response.json();",
                                            "if (jsonData.data && jsonData.data.token) {",
                                            "    pm.collectionVariables.set('studentToken', jsonData.data.token);",
                                            "}"
                                        ],
                                        "type": "text/javascript"
                                    }
                                }
                            ],
                            "request": {
                                "method": "POST",
                                "header": [
                                    {
                                        "key": "Accept",
                                        "value": "application/json"
                                    }
                                ],
                                "body": {
                                    "mode": "raw",
                                    "raw": "{\n    \"email\": \"student.budi@example.com\",\n    \"password\": \"password\"\n}",
                                    "options": { "raw": { "language": "json" } }
                                },
                                "url": "{{baseUrl}}/login"
